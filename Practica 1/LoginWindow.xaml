<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="396" Width="481" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="GamingButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#07314a" Offset="0" />
                                        <GradientStop Color="#00243a" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00d1ff" Offset="0" />
                                        <GradientStop Color="#0088ff" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,2" />
                            </Border>
                            <Border x:Name="Glow" CornerRadius="8" Background="Transparent" IsHitTestVisible="False" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00b3ff" BlurRadius="18" ShadowDepth="0" Opacity="0.0" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                <Setter TargetName="Glow" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00b3ff" BlurRadius="20" ShadowDepth="0" Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#0a1220">
        <!-- Logo en esquina superior izquierda -->
        <Image x:Name="Logo_Blizzard" Source="/Practica 1;component/Images/Blizzard.png" Width="194" Height="179" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-23,140,0" RenderTransformOrigin="0.5,0.5" >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.138"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Border CornerRadius="8" Background="#0f1724" BorderBrush="#09314a" BorderThickness="1" Padding="16" Margin="20,80,20,20">
            <StackPanel>
                <TextBlock Text="Iniciar sesión" FontSize="20" FontWeight="Bold" Foreground="#8fbfff" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="Usuario" Foreground="White" Margin="6,6,0,2" />
                <TextBox x:Name="UsernameBox" Height="28" />

                <TextBlock Text="Contraseña" Foreground="White" Margin="6,10,0,2" />
                <PasswordBox x:Name="PasswordBox" Height="28" />

                <TextBlock x:Name="MessageText" Text="" Foreground="Salmon" Margin="6,8,0,0" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button x:Name="LoginButton" Content="Login" Width="110" Height="34" Style="{StaticResource GamingButtonStyle}" Click="LoginButton_Click" />
                    <Button x:Name="ExitButton" Content="Salir" Width="110" Height="34" Margin="12,0,0,0" Style="{StaticResource GamingButtonStyle}" Background="#22313a" Foreground="White" Click="ExitButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>